# Правила R8 для релизной сборки.

# SettingsActivity упоминается строкой в res/xml/wallpaper.xml
# (android:settingsActivity="com.example.ascii_wallpapers.SettingsActivity"),
# поэтому R8 не должен переименовывать классы приложения — иначе кнопка
# настроек у живых обоев перестаёт открываться.
-keepnames class com.example.ascii_wallpapers.**
